@@ -0,0 +1,386 @@
+"""
+Tests de regresión para Fase 4 — Fix CRITICAL de GUI.
+
+Cubre los 4 issues CRITICAL del análisis (Task 5 — GUI layer):
+
+- C1: ``ResultadoMuestraDialog._guardar`` referenciaba ``self.ref_text``
+  (widget que NUNCA se crea) → AttributeError al pulsar
+  "💾 Guardar Resultados". Tras Fase 4, ``valor_ref`` queda como
+  ``None`` y el guardado delega las referencias por ítem al JSON
+  de ``resultado_final``.
+
+- C2: ``DashboardView.refresh()`` era no-op (sólo un comentario
+  "# Aquí cargarías datos reales desde los servicios") → las 4
+  tarjetas siempre mostraban "0". Tras Fase 4, ``refresh()`` invoca
+  ``ReportService.get_dashboard_stats()`` y vuelca los conteos en
+  los ``QLabel`` de cada tarjeta.
+
+- C3: ``app.py`` y ``splash.py`` referenciaban ``logo_sidebar.png``
+  (lowercase) pero el asset real es ``Logo_Sidebar.png`` (PascalCase)
+  → en Linux/macOS el logo no carga y cae al fallback de texto.
+
+- C4: ``muestra_dialog.py`` (líneas 823, 1083) y ``vacuna_dialog.py``
+  llamaban ``os.startfile(filepath)`` que SOLO existe en Windows →
+  AttributeError en macOS/Linux. Tras Fase 4, todo pasa por
+  ``gui_pyside.utils.platform_utils.open_file_externally`` que
+  despacha ``os.startfile`` / ``open`` / ``xdg-open`` según el SO.
+
+Los tests no abren ventanas reales: verifican propiedades estáticas
+del código fuente y comportamientos del helper multiplataforma con
+``monkeypatch`` de ``subprocess.Popen`` / ``os.startfile``.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+import textwrap
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Helpers
+# ─────────────────────────────────────────────────────────────────────────────
+
+def _read(rel_path: str) -> str:
+    """Lee un archivo del repo como texto UTF-8."""
+    return (REPO_ROOT / rel_path).read_text(encoding="utf-8")
+
+
+def _setup_test_db() -> None:
+    """Crea las tablas mínimas para que ReportService funcione."""
+    from config import DB_PATH
+    from database.connection import DatabaseManager
+
+    db = DatabaseManager()
+    db.execute("""
+        CREATE TABLE IF NOT EXISTS animales (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            nombre TEXT, codigo TEXT, estado TEXT,
+            fecha_ingreso TEXT
+        )
+    """)
+    db.execute("""
+        CREATE TABLE IF NOT EXISTS muestras (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            codigo TEXT, estado TEXT, urgente INTEGER DEFAULT 0,
+            fecha_recoleccion TEXT, fecha_entrega TEXT,
+            resultado TEXT, valor_referencia TEXT,
+            tecnico TEXT, created_at TEXT
+        )
+    """)
+    db.execute("""
+        CREATE TABLE IF NOT EXISTS consultas (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            fecha_hora TEXT
+        )
+    """)
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# C1 — self.ref_text AttributeError en ResultadoMuestraDialog._guardar
+# ─────────────────────────────────────────────────────────────────────────────
+
+def test_c1_no_self_ref_text_in_guardar():
+    """El cuerpo de ``_guardar`` ya no debe referenciar ``self.ref_text``
+    en código ejecutable (sí puede mencionarlo en comentarios)."""
+    src = _read("gui_pyside/dialogs/muestra_dialog.py")
+
+    # Localizar el método _guardar dentro de ResultadoMuestraDialog.
+    # Hay dos `_guardar` en el archivo (NuevaMuestraDialog y
+    # ResultadoMuestraDialog). El bug estaba en el segundo, que es
+    # el que llama a `actualizar_estado(..., valor_ref)`.
+    matches = list(re.finditer(r"def _guardar\(self\):", src))
+    assert len(matches) >= 2, "Se esperaban al menos 2 métodos _guardar"
+
+    # Tomar el último (ResultadoMuestraDialog._guardar)
+    start = matches[-1].start()
+    end = src.find("\n    @", start)
+    if end == -1:
+        end = len(src)
+    guardar_body = src[start:end]
+
+    # Quitar comentarios (# ...) línea por línea para no detectar
+    # menciones explicativas dentro del fix (como "antes se referenciaba
+    # self.ref_text.toPlainText()").
+    code_only_lines = []
+    for line in guardar_body.splitlines():
+        stripped = line.lstrip()
+        if stripped.startswith("#"):
+            continue
+        # Quitar la parte de comentario inline si la hay
+        if "#" in line:
+            line = line.split("#", 1)[0]
+        code_only_lines.append(line)
+    code_only = "\n".join(code_only_lines)
+
+    assert "self.ref_text" not in code_only, (
+        "ResultadoMuestraDialog._guardar todavía referencia self.ref_text "
+        "(widget inexistente) en código ejecutable — el bug C1 no está "
+        "arreglado."
+    )
+
+    # Y debe seguir llamando a actualizar_estado con un valor_ref seguro.
+    assert "actualizar_estado" in code_only
+    assert "valor_ref" in code_only
+
+
+def test_c1_widget_ref_text_never_created():
+    """Ningún método del diálogo asigna ``self.ref_text`` — confirmación
+    estática de que el atributo jamás existió."""
+    src = _read("gui_pyside/dialogs/muestra_dialog.py")
