+def test_c4_helper_uses_correct_command_per_platform(monkeypatch, tmp_path):
+    """El helper debe dispatchar al comando correcto según ``sys.platform``."""
+    from gui_pyside.utils import platform_utils
+
+    # Crear un archivo real para que la verificación de existencia pase.
+    target = tmp_path / "sample.pdf"
+    target.write_bytes(b"%PDF-1.4 fake")
+
+    calls = []
+
+    def fake_popen(args, **kwargs):
+        calls.append(args)
+
+    # Caso Linux
+    monkeypatch.setattr(platform_utils.sys, "platform", "linux")
+    monkeypatch.setattr(platform_utils.subprocess, "Popen", fake_popen)
+    monkeypatch.delattr(platform_utils.os, "startfile", raising=False)
+
+    ok = platform_utils.open_file_externally(target)
+    assert ok is True
+    assert calls and calls[0][0] == "xdg-open"
+    assert str(target) in calls[0]
+
+    # Caso macOS
+    calls.clear()
+    monkeypatch.setattr(platform_utils.sys, "platform", "darwin")
+    ok = platform_utils.open_file_externally(target)
+    assert ok is True
+    assert calls and calls[0][0] == "open"
+
+    # Caso Windows: simular os.startfile
+    calls.clear()
+    monkeypatch.setattr(platform_utils.sys, "platform", "win32")
+
+    startfile_calls = []
+
+    def fake_startfile(p):
+        startfile_calls.append(p)
+
+    monkeypatch.setattr(platform_utils.os, "startfile", fake_startfile, raising=False)
+    ok = platform_utils.open_file_externally(target)
+    assert ok is True
+    assert startfile_calls and startfile_calls[0] == str(target)
+
