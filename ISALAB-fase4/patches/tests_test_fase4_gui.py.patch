+def test_c4_no_os_startfile_in_productive_dialogs():
+    """Ningún diálogo productivo debe llamar ``os.startfile(...)`` fuera
+    del helper centralizado. El helper SÍ puede usarlo (guardado por
+    ``sys.platform.startswith('win')``)."""
+    forbidden_files = [
+        "gui_pyside/dialogs/muestra_dialog.py",
+        "gui_pyside/dialogs/vacuna_dialog.py",
+    ]
+    pattern = re.compile(r"os\.startfile\s*\(")
+    for rel in forbidden_files:
+        src = _read(rel)
+        # Buscar usos reales (no comentarios ni strings)
+        for line_no, line in enumerate(src.splitlines(), start=1):
+            stripped = line.lstrip()
+            if stripped.startswith("#"):
+                continue
+            # Quitar strings para no falsos-positivos en docstrings/comentarios inline
+            # — basta con verificar que NO haya una llamada directa.
+            assert not pattern.search(line), (
+                f"{rel}:{line_no} todavía llama os.startfile() directamente: "
+                f"{line.strip()!r}"
+            )
+
