+def test_c2_refresh_body_is_not_a_comment_only():
+    """El cuerpo de ``refresh()`` ya no debe ser sólo el comentario
+    '# Aquí cargarías datos reales desde los servicios'."""
+    src = _read("gui_pyside/views/dashboard.py")
+    # Localizar el método refresh
+    m = re.search(r"def refresh\(self\):", src)
+    assert m, "DashboardView.refresh no existe"
+
+    # Extraer el cuerpo (hasta el siguiente método a la misma indentación
+    # o fin de archivo)
+    start = m.end()
+    # Buscar el siguiente "def " o "    @" con indentación de método
+    next_def = re.search(r"\n    (@|def )", src[start:])
+    body = src[start: start + next_def.start()] if next_def else src[start:]
+
+    assert "# Aquí cargarías datos reales" not in body, (
+        "refresh() todavía contiene el comentario no-op original."
+    )
+    assert "ReportService" in body, (
+        "refresh() no instancia ReportService dentro de su cuerpo."
+    )
+
