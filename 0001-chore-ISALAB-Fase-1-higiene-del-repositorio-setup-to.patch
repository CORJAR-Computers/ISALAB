+# IsaLab — dependencias de desarrollo
+# Instalar con:  pip install -r requirements-dev.txt
+# (incluye automáticamente las de runtime)
+-r requirements.txt
+
+# ── Lint / Formato ─────────────────────────────────────────────────────
+ruff>=0.5.0,<0.7.0             # Linter + formatter (reemplaza flake8/isort)
+black>=24.0.0,<25.0.0          # Formatter complementario
+
+# ── Type-checking ──────────────────────────────────────────────────────
+mypy>=1.10.0,<1.14.0           # Análisis estático de tipos
+
+# ── Testing ────────────────────────────────────────────────────────────
+pytest>=8.0.0,<9.0.0           # Framework de pruebas
+pytest-qt>=4.4.0,<5.0.0        # Fixtures para PySide6
+pytest-cov>=5.0.0,<6.0.0       # Cobertura de código
+pytest-mock>=3.14.0,<4.0.0     # Mocking helpers
+
+# ── Pre-commit hooks ───────────────────────────────────────────────────
+pre-commit>=3.7.0,<4.0.0       # Hooks de git (ruff, black, eof-fixer, etc.)
+
+# ── Empaquetado ────────────────────────────────────────────────────────
+pyinstaller>=6.5.0,<7.0.0      # Generación de ejecutable standalone
+
+# ── Lockfile (reproducibilidad) ────────────────────────────────────────
+pip-tools>=7.4.0,<8.0.0        # pip-compile para generar requirements.lock
