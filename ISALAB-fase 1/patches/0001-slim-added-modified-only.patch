diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..83c74fd
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,207 @@
+# =============================================================================
+# IsaLab — Centro de Diagnóstico Veterinario
+# Configuración unificada de tooling (ruff, black, mypy, pytest, isort)
+# =============================================================================
+
+[build-system]
+requires = ["setuptools>=68.0", "wheel"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "isalab"
+version = "1.0.0"
+description = "Sistema integral de gestión clínica y de laboratorio veterinario"
+readme = "README.md"
+requires-python = ">=3.10"
+license = { text = "Proprietary" }
+authors = [
+    { name = "CORJAR Computers", email = "dev@corjar.com" }
+]
+keywords = ["veterinaria", "laboratorio", "clinica", "pyside6", "sqlalchemy"]
+classifiers = [
+    "Development Status :: 4 - Beta",
+    "Environment :: X11 Applications :: Qt",
+    "Intended Audience :: Healthcare Industry",
+    "Operating System :: Microsoft :: Windows",
+    "Operating System :: POSIX :: Linux",
+    "Programming Language :: Python :: 3",
+    "Programming Language :: Python :: 3.10",
+    "Programming Language :: Python :: 3.11",
+    "Programming Language :: Python :: 3.12",
+    "Topic :: Scientific/Engineering :: Medical Science Apps.",
+]
+dependencies = [
+    "pyside6>=6.6.0,<6.9.0",
+    "sqlalchemy>=2.0.0,<2.1.0",
+    "alembic>=1.13.0,<2.0.0",
+    "pydantic>=2.5.0,<3.0.0",
+    "bcrypt>=4.0.0,<5.0.0",
+    "weasyprint>=60.0,<63.0",
+    "jinja2>=3.1.0,<4.0.0",
+    "Pillow>=10.0.0,<12.0.0",
+    "matplotlib>=3.8.0,<4.0.0",
+]
+
+[project.optional-dependencies]
+dev = [
+    "ruff>=0.5.0,<0.7.0",
+    "black>=24.0.0,<25.0.0",
+    "mypy>=1.10.0,<1.14.0",
+    "pytest>=8.0.0,<9.0.0",
+    "pytest-qt>=4.4.0,<5.0.0",
+    "pytest-cov>=5.0.0,<6.0.0",
+    "pytest-mock>=3.14.0,<4.0.0",
+    "pre-commit>=3.7.0,<4.0.0",
+    "pyinstaller>=6.5.0,<7.0.0",
+    "pip-tools>=7.4.0,<8.0.0",
+]
+
+[project.urls]
+Homepage = "https://github.com/CORJAR-Computers/ISALAB"
+Repository = "https://github.com/CORJAR-Computers/ISALAB"
+Issues = "https://github.com/CORJAR-Computers/ISALAB/issues"
+
+# =============================================================================
+# Ruff — linter + formatter (reemplaza flake8 + isort + pyupgrade)
+# =============================================================================
+[tool.ruff]
+line-length = 100
+target-version = "py310"
+extend-exclude = [
+    ".git",
+    ".venv",
+    "venv",
+    "build",
+    "dist",
+    "localpycs",
+    "alembic/versions",  # migraciones autogeneradas, no las tocamos
+]
+
+[tool.ruff.lint]
+# Reglas activas:
+#   F  = pyflakes (F541 = f-string sin placeholders, etc.)
+#   E  = pycodestyle errors
+#   W  = pycodestyle warnings
+#   I  = isort (orden de imports)
+#   B  = bugbear (bugs comunes)
+#   UP = pyupgrade (modernización de sintaxis)
+#   SIM = simplificaciones
+select = ["F", "E", "W", "I", "B", "UP", "SIM"]
+ignore = [
+    "E501",   # line too long (lo maneja black)
+    "B008",   # function call in default argument (común en PySide6)
+    "SIM108", # ternary en vez de if/else (preferimos if/else explícito)
+]
+
+[tool.ruff.lint.per-file-ignores]
+"__init__.py" = ["F401"]  # exports intencionalmente sin usar
+"tests/*" = ["B011"]      # allow assert False in tests
+
+[tool.ruff.format]
+quote-style = "double"
+indent-style = "space"
+line-ending = "lf"
+
+# =============================================================================
+# Black — formatter complementario
+# =============================================================================
+[tool.black]
+line-length = 100
+target-version = ["py310", "py311", "py312"]
+include = '\.pyi?$'
+extend-exclude = '''
+/(
+    \.git
+  | \.venv
+  | venv
+  | build
+  | dist
+  | localpycs
+  | alembic/versions
+)/
+'''
+
+# =============================================================================
+# Mypy — type-checking estático
+# =============================================================================
+[tool.mypy]
+python_version = "3.10"
+warn_return_any = true
+warn_unused_configs = true
+warn_redundant_casts = true
+warn_unused_ignores = true
+disallow_untyped_defs = false  # activar gradualmente
+disallow_incomplete_defs = false
+check_untyped_defs = true
+no_implicit_optional = true
+strict_equality = true
+show_error_codes = true
+show_column_numbers = true
+pretty = true
+
+# Exclusiones: archivos que no vale la pena type-checkear todavía
+exclude = [
+    "^alembic/versions/",
+    "^build_app\\.py$",
+    "^icon_manager\\.py$",
+]
+
+# overrides para módulos sin stubs
+[[tool.mypy.overrides]]
+module = ["PySide6.*", "weasyprint.*", "matplotlib.*"]
+ignore_missing_imports = true
+
+# =============================================================================
+# Pytest — configuración
+# =============================================================================
+[tool.pytest.ini_options]
+minversion = "8.0"
+testpaths = ["tests"]
+python_files = ["test_*.py"]
+python_classes = ["Test*"]
+python_functions = ["test_*"]
+addopts = [
+    "-v",
+    "--strict-markers",
+    "--tb=short",
+    "--cov=isalab",
+    "--cov-report=term-missing",
+    "--cov-report=html:htmlcov",
+    "--cov-report=xml",
+    "--no-cov-on-fail",
+]
+markers = [
+    "slow: marks tests as slow (deselect with '-m \"not slow\"')",
+    "integration: marks tests that hit the real DB",
+    "gui: marks tests that require a QApplication",
+]
+filterwarnings = [
+    "error",
+    "ignore::DeprecationWarning:PySide6.*",
+    "ignore::DeprecationWarning:weasyprint.*",
+]
+
+# =============================================================================
+# Coverage
+# =============================================================================
+[tool.coverage.run]
+source = ["database", "services", "utils", "gui_pyside", "reports", "config.py"]
+omit = [
+    "*/__pycache__/*",
+    "*/alembic/versions/*",
+    "*/tests/*",
+    "*/build_app.py",
+    "*/icon_manager.py",
+]
+
+[tool.coverage.report]
+exclude_lines = [
+    "pragma: no cover",
+    "def __repr__",
+    "raise NotImplementedError",
+    "if __name__ == .__main__.:",
+    "if TYPE_CHECKING:",
+    "if PRODUCTION_MODE:",
+]
+fail_under = 30  # empezar bajo, ir subiendo
+show_missing = true
