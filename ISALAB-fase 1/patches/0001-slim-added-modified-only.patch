+# =============================================================================
+# IsaLab — Variables de entorno
+# Copia este archivo a .env y ajusta los valores según tu entorno.
+# NUNCA commitees el archivo .env real (está en .gitignore).
+# =============================================================================
+
+# ── Modo de operación ───────────────────────────────────────────────────
+# 1 = producción (oculta trazas, mensajes genéricos al usuario)
+# 0 = desarrollo (muestra stack traces completos)
+ISALAB_PRODUCTION_MODE=0
+
+# ── Nivel de logging ────────────────────────────────────────────────────
+# Valores válidos: DEBUG, INFO, WARNING, ERROR, CRITICAL
+ISALAB_LOG_LEVEL=INFO
+
+# ── Ruta de la base de datos ────────────────────────────────────────────
+# Por defecto: data/isalab.db (relativa al directorio del proyecto)
+# Sobrescribir solo si necesitas una ubicación personalizada.
+# ISALAB_DB_PATH=/ruta/absoluta/a/isalab.db
+
+# ── Debug en modo congelado (PyInstaller) ───────────────────────────────
+# 1 = abrir consola con prints y trazas (solo para depurar el .exe)
+# 0 = modo silencioso (producción)
+ISALAB_DEBUG=0
