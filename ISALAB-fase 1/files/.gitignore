# ==========================================
# IsaLab - .gitignore
# ==========================================

# ── Entorno Virtual de Python y Caches ──
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# ── Archivos de Build y PyInstaller ──
build/
dist/
localpycs/
*.toc
*.pkg
*.pyz
warn-*.txt
xref-*.html

# ── Base de Datos Local y Datos Runtime ──
*.db
*.db-journal
*.sqlite
*.sqlite3
identifier.sqlite
data/*.db
data/*.sqlite
data/*.sqlite3
data/imagenes/           # firmas/sellos generados por el usuario
data/lab_config.json     # configuración generada en runtime

# ── Logs y Documentos Generados ──
logs/
*.log
pdfs/
reports/
data/pdfs/

# ── Variables de Entorno y Secretos ──
.env
.env.*
!.env.example
*.env
*.pem
*.key
secrets.json
config_local.py

# ── Lockfile (se genera con pip-compile, NO se commitea) ──
# (descomentar si prefieres no versionar el lock)
#requirements.lock

# ── Configuración de IDEs y Editores ──
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ── Directorios de Agentes AI y Herramientas ──
.agent/
.claude/
.codebuddy/
.codex/
.continue/
.cursor/
.gemini/
.kiro/
.opencode/
.qoder/
.qween/
.roo/
.stakpak/
.trae/
.windsurf/

# ── Archivos del Sistema Operativo ──
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── Duplicados de assets en la raíz del proyecto ──
# PyInstaller a veces los vuelca en CWD; nunca deben commitearse
/icono.ico
/icono.png

# ── Scripts one-shot de mantenimiento ──
# Ya cumplieron su propósito (fix de flake8 F541, formato Jinja, etc.).
# Si se necesitan scripts de mantenimiento nuevos, colocarlos en scripts/.
/fix_*.py

# ── Cobertura de tests ──
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.hypothesis/

# ── Mypy cache ──
.mypy_cache/
.dmypy.json
dmypy.json

# ── Ruff cache ──
.ruff_cache/
