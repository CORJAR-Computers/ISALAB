# ── Entorno Virtual de Python y Caches ──
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# ── Archivos de Build y PyInstaller ──
build/
dist/
localpycs/
*.toc
*.pkg
*.pyz
warn-*.txt
xref-*.html

# ── Base de Datos Local y Datos Runtime ──
*.db
*.db-journal
*.sqlite
*.sqlite3
identifier.sqlite
data/*.db
data/*.sqlite
data/*.sqlite3

# ── Logs y Documentos Generados ──
logs/
*.log
pdfs/
reports/
data/pdfs/

# ── Variables de Entorno y Secretos ──
.env
.env.*
*.env
*.pem
*.key
secrets.json
config_local.py

# ── Configuración de IDEs y Editores ──
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ── Directorios de Agentes AI y Herramientas ──
.agent/
.claude/
.codebuddy/
.codex/
.continue/
.cursor/
.gemini/
.kiro/
.opencode/
.qoder/
.qween/
.roo/
.stakpak/
.trae/
.windsurf/

# ── Archivos del Sistema Operativo ──
