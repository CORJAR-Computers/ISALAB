@@ -0,0 +1,801 @@
+"""
+Fase 6 — Tests de regresión para fixes MEDIUM/LOW.
+
+Cubre los cambios más impactantes de los 4 batches:
+- DB (9-a): Boolean urgente, CheckConstraints, updated_at listener, from_row, synonym.
+- Services (9-b): PermissionDeniedError hierarchy, recepciones_hoy SQL filter,
+  es_urgente() call, report_service guards, configuracion_service deep merge,
+  validar_fortaleza_password symbol requirement.
+- GUI (9-c): lazy generar_codigo, _show_view consolidation, DataTable empty-state,
+  FormField extended validation, splash flags, LoginDialog sanitization.
+- DevOps (9-d): __version__ source, --debug flag, IsaLab.spec optimize=2,
+  alembic.ini ruff hooks.
+
+Los tests son estáticos (inspección de código) o funcionales según corresponda.
+No tocan la DB real — usan las fixtures de conftest.py (tmp_db_path).
+"""
+
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+
+def _read(rel_path: str) -> str:
+    """Lee un archivo del repo como texto."""
+    return (REPO_ROOT / rel_path).read_text(encoding="utf-8")
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# DB-M1: Boolean type for `urgente`
+# ─────────────────────────────────────────────────────────────────────────────
+
+def test_db_m1_urgente_is_boolean_in_orm():
+    """``urgente`` debe estar mapeado como ``Boolean`` (no ``Integer``)."""
+    from sqlalchemy import Boolean
+    from orm_models.clinica import MuestraORM
+    col = MuestraORM.__table__.columns.get("urgente")
+    assert col is not None, "La columna `urgente` no existe en MuestraORM"
+    assert isinstance(col.type, Boolean), (
+        f"Esperado Boolean, got {type(col.type).__name__}"
+    )
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# DB-M2: CheckConstraints on sexo, tipo, estado, via
+# ─────────────────────────────────────────────────────────────────────────────
+
+def test_db_m2_check_constraints_exist_on_animales():
+    """``animales`` debe tener al menos un CHECK constraint (sexo)."""
+    from orm_models.animal import Animal
+    t = Animal.__table__
+    checks = [c for c in t.constraints if c.__class__.__name__ == "CheckConstraint"]
+    assert len(checks) >= 1, (
+        "Animales debe tener al menos 1 CheckConstraint (sexo)"
