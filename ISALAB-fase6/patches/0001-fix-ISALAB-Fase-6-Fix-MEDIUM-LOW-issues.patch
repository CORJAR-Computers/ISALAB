+# ``contraseña=...`` o ``pwd:...``. La regex captura el valor y lo
+# reemplaza. ``\S+`` (no-whitespace) cubre la mayoría de formatos.
+_PASSWORD_KV_RE = re.compile(
+    r'(?i)\b(password|passwd|pwd|contrase[ñn]a|secret|token)\s*[:=]\s*\S+'
+)
+
