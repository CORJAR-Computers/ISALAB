+def test_smoke_migration_chain_single_head():
+    """La cadena de migraciones debe tener un único head."""
+    import ast
+    versions_dir = REPO_ROOT / "alembic" / "versions"
+    revisions = {}
+    for py_file in versions_dir.glob("*.py"):
+        if py_file.name.startswith("__"):
+            continue
+        # Usar ast para extraer revision/down_revision sin ejecutar el módulo
+        # (ejecutarlo falla porque las migraciones importan alembic.op, sa, etc.)
+        try:
+            tree = ast.parse(py_file.read_text(encoding="utf-8"))
+        except SyntaxError:
+            continue
+        rev = None
+        down = None
+        for node in ast.walk(tree):
+            # Migraciones modernas usan anotaciones de tipo:
+            #   revision: str = 'xxxx'
+            #   down_revision: Union[str, ...] = 'yyyy'
+            # → ast.AnnAssign. Las viejas usan ``revision = 'xxxx'``
+            # → ast.Assign. Aceptamos ambas.
+            if isinstance(node, ast.AnnAssign):
+                target = node.target
+                if isinstance(target, ast.Name):
+                    if target.id == "revision" and isinstance(node.value, ast.Constant):
+                        rev = node.value.value
+                    elif target.id == "down_revision":
+                        # Puede ser None, str, o tuple de strs (merge migrations)
+                        if isinstance(node.value, ast.Constant):
+                            down = node.value.value
+                        elif isinstance(node.value, ast.Tuple):
+                            down = tuple(
+                                elt.value for elt in node.value.elts
+                                if isinstance(elt, ast.Constant)
+                            )
+            elif isinstance(node, ast.Assign):
+                for target in node.targets:
+                    if isinstance(target, ast.Name):
+                        if target.id == "revision" and isinstance(node.value, ast.Constant):
+                            rev = node.value.value
+                        elif target.id == "down_revision":
+                            if isinstance(node.value, ast.Constant):
+                                down = node.value.value
+                            elif isinstance(node.value, ast.Tuple):
+                                down = tuple(
+                                    elt.value for elt in node.value.elts
+                                    if isinstance(elt, ast.Constant)
+                                )
+        if rev:
+            revisions[rev] = down
+    # Heads: revisions that are NOT a down_revision of any other.
+    # ``down`` puede ser str o tuple — normalizar a conjunto.
+    all_downs = set()
+    for d in revisions.values():
+        if d is None:
+            continue
+        if isinstance(d, tuple):
+            all_downs.update(d)
+        else:
+            all_downs.add(d)
+    heads = [r for r in revisions if r not in all_downs]
+    assert len(heads) == 1, (
+        f"Esperado 1 head, got {len(heads)}: {heads}"
+    )
+    assert heads[0] == "b3c4d5e6f7a8", (
+        f"Head debe ser b3c4d5e6f7a8 (Fase 6), got {heads[0]}"
+    )
