+# (comillas dobles o simples).
+_PASSWORD_DICT_RE = re.compile(
+    r'''(?i)['"](?:password|passwd|pwd|contrase[ñn]a|secret|token)['"]\s*:\s*['"][^'"]*['"]'''
+)
+
