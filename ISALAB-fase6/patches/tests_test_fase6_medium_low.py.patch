+def test_s_l5_password_requires_symbol():
+    """``validar_fortaleza_password`` debe rechazar contraseñas sin símbolo."""
+    from utils.security import validar_fortaleza_password
+    # 8 chars con mayúscula/minúscula/dígito PERO sin símbolo → inválida
+    es_valida, _ = validar_fortaleza_password('Abc12345')
+    assert not es_valida, (
+        "Abc12345 debe ser inválida (sin símbolo) tras S-L5"
+    )
+    # Con símbolo → válida
+    es_valida, _ = validar_fortaleza_password('Abc12345!')
+    assert es_valida, (
+        "Abc12345! debe ser válida (con símbolo)"
+    )
