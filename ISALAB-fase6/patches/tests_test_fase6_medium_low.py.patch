+# ─────────────────────────────────────────────────────────────────────────────
+# S-M6: recepciones_hoy uses SQL WHERE
+# ─────────────────────────────────────────────────────────────────────────────
+
+def test_s_m6_recepciones_hoy_uses_sql_where():
+    """``recepciones_hoy`` debe filtrar en SQL, no en Python.
+
+    S-M6 delega el filtrado al repositorio vía claves ``fecha_desde`` /
+    ``fecha_hasta`` (el WHERE vive en ``RecepcionRepository.get_all``).
+    Aceptamos cualquiera de las dos implementaciones: que el service
+    tenga el WHERE inline, o que delegue al repo con las claves de
+    rango.
+    """
+    service_src = _read("services/recepcion_service.py")
+    repo_src = _read("database/repositories.py")
+
+    # Camino A: el service tiene WHERE inline.
+    # Camino B: el service pasa 'fecha_desde'/'fecha_hora' al repo, y el
+    # repo construye el WHERE.
+    service_uses_repo_keys = (
+        "fecha_desde" in service_src and "fecha_hasta" in service_src
+    )
+    repo_has_where = (
+        "WHERE" in repo_src.upper() and
+        "fecha_hora" in repo_src and
+        ("fecha_desde" in repo_src or "fecha_hasta" in repo_src)
+    )
+    service_has_inline_where = (
+        re.search(
+            r"def\s+recepciones_hoy\s*\([^)]*\)\s*(?:->[^:\n]+)?:\s*\n"
+            r"((?:.|\n)*?)(?=\n    def |\nclass |\Z)",
+            service_src
+        ) is not None
+    )
+    if service_has_inline_where:
+        match = re.search(
+            r"def\s+recepciones_hoy\s*\([^)]*\)\s*(?:->[^:\n]+)?:\s*\n"
+            r"((?:.|\n)*?)(?=\n    def |\nclass |\Z)",
+            service_src
+        )
+        body = match.group(1)
+        service_has_where = "WHERE" in body.upper()
+    else:
+        service_has_where = False
+
+    assert service_has_where or (service_uses_repo_keys and repo_has_where), (
+        "recepciones_hoy debe filtrar en SQL (inline WHERE o delegando "
+        "al repo con fecha_desde/fecha_hasta). "
+        f"service_uses_repo_keys={service_uses_repo_keys}, "
+        f"repo_has_where={repo_has_where}, "
+        f"service_has_inline_where={service_has_where}"
+    )
+
