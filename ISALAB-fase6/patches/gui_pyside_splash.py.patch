@@ -12,13 +12,24 @@ class SplashScreen(QSplashScreen):
         self.pix.fill(QColor(QT_STYLES['secondary']))
         super().__init__(self.pix)
 
-        # Quitamos el flag de "siempre encima" para que el login pueda estar
