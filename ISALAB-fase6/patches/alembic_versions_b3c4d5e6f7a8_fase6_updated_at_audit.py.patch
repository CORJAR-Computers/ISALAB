+"""fase6_updated_at_audit
+
+Revision ID: b3c4d5e6f7a8
+Revises: c1a2b3c4d5e6
+Create Date: 2026-09-15 12:00:00
+
+Fase 6 — DB batch (3 fixes estructurales):
+
+  (1) DB-M3 — columna ``updated_at`` de auditoría.
+      Se agrega a: animales, recepciones, muestras, cirugias, consultas,
+      vacunaciones, historias_clinicas, movimientos y usuarios.
+      (``propietarios`` no existe como tabla separada en IsaLab —
+      los datos del propietario son columnas de ``animales``.)
+      La columna es ``nullable=True`` porque los registros existentes
+      no la tienen; el listener ``before_flush`` de
+      ``database/connection.py`` la setea automáticamente en cada UPDATE.
+
+  (2) DB-M2 — ``CheckConstraint`` declarativas.
+      Se aplican vía ``batch_alter_table`` (SQLite reconstruye la tabla
+      para poder agregar el constraint). Las whitelists se importan de
+      ``config.py`` (ESTADOS_ANIMAL, ESTADOS_MUESTRA, ESTADOS_RECEPCION,
+      ESTADOS_CIRUGIA, VIAS_ADMINISTRACION) para que la BD sea la fuente
+      única de verdad. SQLite las hace cumplir en INSERT/UPDATE.
+
+  (3) DB-M6 — ``movimientos.fecha_hora`` NOT NULL.
+      Antes era ``String(50)`` nullable, y como
+      ``MovimientoRepository.create`` no lo seteaba explícitamente,
+      quedaba siempre en NULL. Aquí hacemos:
+        (a) ``UPDATE movimientos SET fecha_hora = datetime('now')
+            WHERE fecha_hora IS NULL`` (backfill).
+        (b) ``batch_alter_table('movimientos')`` con
+            ``alter_column('fecha_hora', nullable=False,
+            server_default=sa.text("(datetime('now'))"))``.
+
+Esta migración es idempotente: verifica existencia de columnas antes
+de agregarlas, y verifica existencia de constraints por nombre antes
+de crearlas (vía ``sqlite_master``). Se puede correr N veces sin error.
+"""
+from typing import Sequence, Union
+
+from alembic import op
+import sqlalchemy as sa
+
+
+# revision identifiers, used by Alembic.
+revision: str = 'b3c4d5e6f7a8'
+# Fase 5 head — single head confirmado por ``alembic heads``.
+down_revision: Union[str, Sequence[str], None] = 'c1a2b3c4d5e6'
+branch_labels: Union[str, Sequence[str], None] = None
+depends_on: Union[str, Sequence[str], None] = None
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# DB-M3 — tablas que reciben ``updated_at`` (DB-M3).
+# Nota: ``propietarios`` NO existe como tabla en IsaLab (los datos del
+# propietario son columnas dentro de ``animales``). Se omite.
+# ─────────────────────────────────────────────────────────────────────────────
+TABLES_WITH_UPDATED_AT = [
+    'animales',
+    'recepciones',
+    'muestras',
+    'cirugias',
+    'consultas',
+    'vacunaciones',
+    'historias_clinicas',
+    'movimientos',
+    'usuarios',
+]
+
+
+def _table_exists(bind, table_name: str) -> bool:
+    """True si la tabla existe en ``sqlite_master``."""
+    result = bind.execute(sa.text(
+        "SELECT name FROM sqlite_master "
+        "WHERE type='table' AND name=:t"
+    ), {"t": table_name}).fetchone()
+    return result is not None
+
+
+def _column_exists(bind, table_name: str, column_name: str) -> bool:
+    """True si la columna existe en la tabla (vía ``PRAGMA table_info``)."""
+    if not _table_exists(bind, table_name):
+        return False
+    cols = bind.execute(sa.text(f"PRAGMA table_info({table_name})")).fetchall()
+    return any(c[1] == column_name for c in cols)
+
+
+def _constraint_exists(bind, name: str) -> bool:
+    """True si un constraint con ese nombre ya existe."""
+    # SQLite guarda CHECKs en ``sqlite_master.sql`` (no hay catálogo
+    # separado). Buscamos por nombre en ``sql``.
+    result = bind.execute(sa.text(
+        "SELECT name FROM sqlite_master "
+        "WHERE type IN ('table', 'index') AND name=:n"
+    ), {"n": name}).fetchone()
+    if result:
+        return True
+    # En SQLite, los CHECKs no son filas separadas en sqlite_master —
+    # están embebidos en el ``sql`` de CREATE TABLE. Verificamos con LIKE.
+    result = bind.execute(sa.text(
+        "SELECT sql FROM sqlite_master "
+        "WHERE type='table' AND sql LIKE :pat"
+    ), {"pat": f"%CONSTRAINT {name}%"}).fetchone()
+    return result is not None
+
+
+def _sql_in_list(values):
+    """Genera el SQL ``IN ('a', 'b', ...)`` escapando comillas simples."""
+    quoted = ",".join(
+        "'" + str(v).replace("'", "''") + "'" for v in values
+    )
+    return f"IN ({quoted})"
+
+
+def upgrade() -> None:
+    """Aplica DB-M2, DB-M3 y DB-M6. Idempotente."""
+
+    # Importamos whitelists desde config (si no está disponible, fallback).
+    try:
+        from config import (
+            ESTADOS_ANIMAL, ESTADOS_MUESTRA, ESTADOS_RECEPCION,
+            ESTADOS_CIRUGIA, VIAS_ADMINISTRACION,
+        )
+    except Exception:
+        ESTADOS_ANIMAL = ['Activo', 'En Tratamiento', 'Cuarentena', 'Dado de Alta']
+        ESTADOS_MUESTRA = ['Pendiente', 'En Proceso', 'Completado', 'Descartado']
+        ESTADOS_RECEPCION = ['En espera', 'En consulta', 'Finalizado', 'Cancelado']
+        ESTADOS_CIRUGIA = ['Programada', 'En proceso', 'Completada', 'Cancelada']
+        VIAS_ADMINISTRACION = [
+            'Subcutánea (SC)', 'Intramuscular (IM)', 'Intravenosa (IV)',
+            'Oral (PO)', 'Tópica', 'Intranasal', 'Otra',
+        ]
+
+    bind = op.get_bind()
+
+    # ── DB-M3: añadir ``updated_at`` a todas las tablas auditables ──────────
+    for table in TABLES_WITH_UPDATED_AT:
+        if not _table_exists(bind, table):
+            continue
+        if _column_exists(bind, table, 'updated_at'):
+            continue
+        bind.execute(sa.text(
+            f"ALTER TABLE {table} "
+            "ADD COLUMN updated_at DATETIME"
+        ))
+
+    # ── DB-M6: backfill de ``movimientos.fecha_hora`` NULL ──────────────────
+    # Antes de hacer la columna NOT NULL, llenamos los NULLs existentes
+    # con el timestamp actual para que el ALTER no falle.
+    if _table_exists(bind, 'movimientos') and _column_exists(bind, 'movimientos', 'fecha_hora'):
+        bind.execute(sa.text(
+            "UPDATE movimientos SET fecha_hora = datetime('now') "
+            "WHERE fecha_hora IS NULL"
+        ))
+
+    # ── DB-M2 + DB-M6: batch_alter_table para CHECK constraints ────────────
+    # En SQLite, ``batch_alter_table`` reconstruye la tabla temporalmente
+    # para poder agregar constraints / alterar columnas. Para tablas con
+    # FKs y datos existentes, Alembic maneja el copy-and-swap.
+    #
+    # Orden: primero ``movimientos`` (DB-M6), luego los CHECK constraints
+    # (DB-M2) tabl por tabla.
+
+    # DB-M6 — movimientos.fecha_hora NOT NULL con server_default.
+    if _table_exists(bind, 'movimientos'):
+        with op.batch_alter_table('movimientos', schema=None) as batch_op:
+            batch_op.alter_column(
+                'fecha_hora',
+                existing_type=sa.String(length=50),
+                nullable=False,
+                server_default=sa.text("(datetime('now'))"),
+            )
+
+    # DB-M2 — CheckConstraints por tabla.
+    # Cada ``batch_alter_table`` reconstruye la tabla para embeber el
+    # ``CHECK`` en el ``CREATE TABLE`` (SQLite no soporta
+    # ``ALTER TABLE ADD CONSTRAINT``).
+    check_specs = [
+        ('animales', 'ck_animales_sexo',
+         f"sexo {_sql_in_list(['Macho', 'Hembra', 'Desconocido'])}"),
+        ('animales', 'ck_animales_estado',
+         f"estado {_sql_in_list(ESTADOS_ANIMAL)}"),
+        ('muestras', 'ck_muestras_estado',
+         f"estado {_sql_in_list(ESTADOS_MUESTRA)}"),
+        ('recepciones', 'ck_recepciones_estado',
+         f"estado {_sql_in_list(ESTADOS_RECEPCION)}"),
+        ('cirugias', 'ck_cirugias_estado',
+         f"estado {_sql_in_list(ESTADOS_CIRUGIA)}"),
+        ('vacunaciones', 'ck_vacunaciones_via',
+         f"via {_sql_in_list(VIAS_ADMINISTRACION)}"),
+    ]
+    for table_name, ck_name, ck_cond in check_specs:
+        if not _table_exists(bind, table_name):
+            continue
+        if _constraint_exists(bind, ck_name):
+            continue
+        with op.batch_alter_table(table_name, schema=None) as batch_op:
+            batch_op.create_check_constraint(ck_name, ck_cond)
+
+
+def downgrade() -> None:
+    """Revierte DB-M2 (drops CHECK), DB-M3 (drops updated_at), DB-M6 (nullable)."""
+    bind = op.get_bind()
+
+    # ── DB-M2: drops CHECK constraints ──────────────────────────────────────
+    check_specs = [
+        ('animales', 'ck_animales_sexo'),
+        ('animales', 'ck_animales_estado'),
+        ('muestras', 'ck_muestras_estado'),
+        ('recepciones', 'ck_recepciones_estado'),
+        ('cirugias', 'ck_cirugias_estado'),
+        ('vacunaciones', 'ck_vacunaciones_via'),
+    ]
+    for table_name, ck_name in check_specs:
+        if not _table_exists(bind, table_name):
+            continue
+        if not _constraint_exists(bind, ck_name):
+            continue
+        with op.batch_alter_table(table_name, schema=None) as batch_op:
+            batch_op.drop_constraint(ck_name, type_='check')
+
+    # ── DB-M6: revertir ``movimientos.fecha_hora`` a nullable ───────────────
+    if _table_exists(bind, 'movimientos'):
+        with op.batch_alter_table('movimientos', schema=None) as batch_op:
+            batch_op.alter_column(
+                'fecha_hora',
+                existing_type=sa.String(length=50),
+                nullable=True,
+                server_default=None,
+            )
+
+    # ── DB-M3: drops ``updated_at`` ─────────────────────────────────────────
+    for table in TABLES_WITH_UPDATED_AT:
+        if not _table_exists(bind, table):
+            continue
+        if not _column_exists(bind, table, 'updated_at'):
+            continue
+        with op.batch_alter_table(table, schema=None) as batch_op:
+            batch_op.drop_column('updated_at')
